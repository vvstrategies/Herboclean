# Apache e hospedagem compartilhada (Hostinger, cPanel, Locaweb).
#
# O site funciona SEM este arquivo: cada rota tem a sua pasta com index.html,
# e isso qualquer servidor entende. Este arquivo serve para duas melhorias:
#
#   1. abrir /servicos/higienizacao-de-sofa sem a barra no fim, sem redirecionar
#   2. usar a pagina 404 do proprio site em vez da do servidor
#
# Em Vercel, Netlify e Cloudflare Pages ele e ignorado, e nao atrapalha.

Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /rota -> /rota.html, quando o arquivo existir
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# Cache: o conteudo de /_next/ tem o hash no nome e nunca muda.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg   "access plus 1 month"
  ExpiresByType image/png    "access plus 1 month"
  ExpiresByType image/webp   "access plus 1 month"
  ExpiresByType font/woff2   "access plus 1 year"
  ExpiresByType text/css     "access plus 1 month"
  ExpiresByType text/html    "access plus 10 minutes"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
